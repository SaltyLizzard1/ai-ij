OPENROUTER_API_KEY=your-openrouter-key-here

# Model to use via OpenRouter. Good options:
#   anthropic/claude-sonnet-4-5   (fast, great quality - recommended)
#   anthropic/claude-opus-4       (best quality, higher cost)
#   openai/gpt-4o                 (alternative)
OPENROUTER_MODEL=anthropic/claude-sonnet-4-5

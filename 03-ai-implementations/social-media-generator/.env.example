# ---- LLM ----
LLM_PROVIDER=anthropic            # anthropic | openai | mock
ANTHROPIC_API_KEY=sk-ant-...      # or run `ant auth login` and leave this unset
# LLM_MODEL=claude-opus-5         # default per provider
# LLM_EFFORT=medium               # Anthropic: low|medium|high|xhigh|max (default high)
ANTHROPIC_SERVER_FALLBACKS=true   # re-run a refused request on a fallback model server-side

# ---- Camera roll (Google Drive for Desktop) ----
IMAGE_ROOT=X:\
RECORDS_DIR=C:\Users\lizal\Scripts\photo-organizer\records   # where blur2.csv lives
SKIP_FOLDERS=blurred,$RECYCLE.BIN,System Volume Information
MAX_BLUR=0.42                     # same cut-off your organiser uses
# MIN_CONTRAST=25
TAG_MAX_PER_RUN=60                # cap on photos sent to the vision model per run
TAG_IMAGE_MAX_EDGE=1024

# ---- Storage / output ----
DB_PATH=social_pipeline.db
OUTPUT_DIR=./output

# ---- Content ----
BRAND_NAME=Quit Your Life and Travel
BRAND_VOICE_FILE=brand/qylat.md
PLATFORMS=facebook,instagram,linkedin,x
FORBID_EM_DASHES=true
FORBID_FINANCIAL_FIGURES=true
ALLOW_HASHTAGS=false
MAX_POSTS_PER_ARTICLE=6
HOOK_CHUNKS=2
CHUNK_MIN_CHARS=150
CHUNK_MAX_CHARS=700

# ---- Leap Log (article source) ----
SITE_BASE_URL=https://www.quityourlifeandtravel.com
SANITY_PROJECT_ID=zvvdrylu
SANITY_DATASET=production
LEAPLOG_PINNED_SLUG=how-to-move-to-thailand-in-60-days
LEAPLOG_EXTRA_SLUGS=how-to-move-to-thailand-in-60-days   # posts that live only in data/posts.tsx

# ---- Scheduling ----
TIMEZONE=Asia/Bangkok
WEEKDAYS_ONLY=true
SEASONAL_SCHEDULING=false         # true -> photos from past months wait for that month next year
STRICT_MONTH=false                # true -> only photos from the target month are eligible

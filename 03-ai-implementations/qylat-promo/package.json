{
  "name": "qylat-promo",
  "version": "0.1.0",
  "private": true,
  "description": "Automated walkthrough video of quityourlifeandtravel.com: Playwright drives the site and records it, Remotion adds the camera zooms, captions and narration.",
  "scripts": {
    "record": "tsx scripts/record.ts",
    "record:short": "tsx scripts/record.ts --short",
    "record:wide": "tsx scripts/record.ts --landscape",
    "record:short:wide": "tsx scripts/record.ts --short --landscape",
    "studio": "remotion studio",
    "render": "remotion render full-portrait out/qylat-full-portrait.mp4",
    "render:short": "remotion render short-portrait out/qylat-short-portrait.mp4",
    "render:wide": "remotion render full-landscape out/qylat-full-landscape.mp4",
    "render:short:wide": "remotion render short-landscape out/qylat-short-landscape.mp4",
    "video": "npm run record && npm run render",
    "video:short": "npm run record:short && npm run render:short",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.525",
    "@remotion/fonts": "^4.0.525",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.525"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "playwright": "^1.56.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
